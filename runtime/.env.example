# Set these in the launching process. This project does not auto-load .env.
MCMATE_PROVIDER=fixture
MCMATE_USER_ID=local
# Fixture defaults: demo-store, pickup. Live requires real verified selections.
# MCMATE_RESTAURANT_ID=
# MCMATE_BUSINESS_ENTITY_ID=
# MCMATE_CHANNEL=pickup
# MCMATE_DB=/absolute/path/memory.sqlite
# Live only: obtain your own token from the official provider.
# MCD_MCP_TOKEN=
# MCMATE_BINDING_MODULE=/absolute/path/reviewed-bindings.mjs
# Optional local web: fixture by default, never reads the persistent preference DB.
# MCMATE_WEB_PORT=8787
# Web live requires the account-reviewed pickup factory; see docs/official-pickup-validation.md.
